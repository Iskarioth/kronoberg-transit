# Copy to .env and fill in. Never commit .env.

# Trafiklab (developer.trafiklab.se), one project, three keys
TRAFIKLAB_KODA_KEY=
TRAFIKLAB_GTFS_STATIC_KEY=
TRAFIKLAB_GTFS_RT_KEY=

# Hugging Face (huggingface.co/settings/tokens), write access
HF_TOKEN=
HF_DATASET_REPO=

# Google Sheets
GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_FILE=secrets/google_service_account.json
